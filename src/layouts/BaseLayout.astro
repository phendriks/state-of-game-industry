---
import '../styles/global.css';
const { title = 'Game Industry Observatory', description = 'AI-assisted games-industry data reporting.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const storageKey = 'game-industry-theme';
        let savedTheme = null;

        try {
          savedTheme = localStorage.getItem(storageKey);
        } catch {}

        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = savedTheme === 'dark' || savedTheme === 'light'
          ? savedTheme
          : prefersDark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${import.meta.env.BASE_URL}`}>Game Industry Observatory</a>
      <div class="header-actions">
        <nav>
          <a href={`${import.meta.env.BASE_URL}`}>Latest</a>
          <a href={`${import.meta.env.BASE_URL}history/`}>Data</a>
          <a href={`${import.meta.env.BASE_URL}methodology/`}>Methodology</a>
          <a href={`${import.meta.env.BASE_URL}sources/`}>Sources</a>
          <a href={`${import.meta.env.BASE_URL}submit-source/`}>Propose a source</a>
        </nav>
        <button class="theme-toggle" type="button" aria-pressed="false">Night mode</button>
      </div>
    </header>
    <main class="shell"><slot /></main>
    <footer class="site-footer">
      <strong>AI-generated industry aggregation.</strong>
      Source coverage is weighted toward English-language, North American and European / Western-facing games-industry information. Data and AI-generated analysis may contain errors.
    </footer>
    <script is:inline>
      (() => {
        const storageKey = 'game-industry-theme';
        const toggle = document.querySelector('.theme-toggle');

        if (!(toggle instanceof HTMLButtonElement)) return;

        const updateToggle = () => {
          const isDark = document.documentElement.dataset.theme === 'dark';
          toggle.setAttribute('aria-pressed', String(isDark));
          toggle.textContent = isDark ? 'Light mode' : 'Night mode';
        };

        toggle.addEventListener('click', () => {
          const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = nextTheme;

          try {
            localStorage.setItem(storageKey, nextTheme);
          } catch {}

          updateToggle();
        });

        updateToggle();
      })();
    </script>
  </body>
</html>
