---
import BaseLayout from '../layouts/BaseLayout.astro';

const registryEditUrl = 'https://github.com/phendriks/state-of-game-industry/edit/main/src/data/newsSources.ts';
---
<BaseLayout title="Propose a source · Game Industry Observatory">
  <section class="hero compact">
    <p class="eyebrow">Improve the evidence base</p>
    <h1>Propose a source</h1>
    <p class="lede">Suggest a source through GitHub. The owner reviews each proposal.</p>
  </section>

  <div class="form-layout contribution-layout">
    <section class="panel contribution-steps">
      <p class="eyebrow">GitHub contribution</p>
      <h2>Edit the source registry</h2>
      <ol>
        <li>Sign in to GitHub and open the registry.</li>
        <li>Add your source under the best category.</li>
        <li>Select <strong>Propose changes</strong> and explain its value.</li>
        <li>Open a pull request for review.</li>
      </ol>
      <a class="button" href={registryEditUrl}>Edit the registry on GitHub</a>
      <p class="form-note">GitHub creates a fork if needed. Only merged changes reach the site.</p>
    </section>

    <aside class="panel review-note">
      <p class="eyebrow">Simple entry</p>
      <h2>What to include</h2>
      <pre class="source-example"><code>{`{
  name: 'Source name',
  url: 'https://example.com/',
  type: 'Research / survey',
  notes: 'Optional useful context'
}`}</code></pre>
      <p>Include a name, URL and type. Notes are optional.</p>
      <p>Disclose any affiliation in the pull request.</p>
    </aside>
  </div>
</BaseLayout>
