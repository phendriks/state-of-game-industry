---
import BaseLayout from '../layouts/BaseLayout.astro';

const registryEditUrl = 'https://github.com/phendriks/state-of-game-industry/edit/main/src/data/newsSources.ts';
---
<BaseLayout title="Propose a source · Game Industry Observatory">
  <section class="hero compact">
    <p class="eyebrow">Improve the evidence base</p>
    <h1>Propose a source</h1>
    <p class="lede">Suggest a feed, tracker, dataset or publication by proposing an edit to the public source registry. GitHub records your contribution and the repository owner reviews it before anything changes.</p>
  </section>

  <div class="form-layout contribution-layout">
    <section class="panel contribution-steps">
      <p class="eyebrow">GitHub contribution</p>
      <h2>Edit the source registry</h2>
      <ol>
        <li>Sign in to GitHub and open the registry using the button below.</li>
        <li>Find the best category and add one source entry using the existing format.</li>
        <li>Select <strong>Propose changes</strong>, briefly explain why the source belongs, and open the pull request.</li>
        <li>The repository owner reviews, discusses and either merges or declines the proposal.</li>
      </ol>
      <a class="button" href={registryEditUrl}>Edit the registry on GitHub</a>
      <p class="form-note">For contributors without write access, GitHub creates a fork automatically. Your proposal cannot alter the live site until it is reviewed and merged.</p>
    </section>

    <aside class="panel review-note">
      <p class="eyebrow">Entry format</p>
      <h2>What to include</h2>
      <pre class="source-example"><code>{`{
  name: 'Source name',
  url: 'https://example.com/',
  coverage: 'What it measures',
  cadence: 'Continuous'
}`}</code></pre>
      <p>Use one of the cadence values already supported by the registry: <strong>Continuous</strong>, <strong>Quarterly</strong>, <strong>Annual</strong> or <strong>Periodic</strong>.</p>
      <p>In the pull-request description, mention geographic coverage, access restrictions and any relationship you have with the source.</p>
    </aside>
  </div>
</BaseLayout>
