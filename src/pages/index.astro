---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SnapshotOverview from '../components/SnapshotOverview.astro';
import ReportDataTables from '../components/ReportDataTables.astro';
import EvidenceBase from '../components/EvidenceBase.astro';
const reports = (await getCollection('reports')).sort((a,b) => b.data.published.getTime() - a.data.published.getTime());
const latest = reports[0];
const { Content } = await render(latest);
type SignalMetric={id:string;display_value:string;detail:string};
const metricsById=new Map<string,SignalMetric>((latest.data.metrics as SignalMetric[]).map(metric=>[metric.id,metric]));
const revenue=metricsById.get('global_games_revenue');
const openRoles=metricsById.get('open_roles');
const entryShare=metricsById.get('entry_level_role_share');
const engineeringShare=metricsById.get('engineering_role_share');
const layoffs=metricsById.get('confirmed_layoffs_2026')??metricsById.get('current_year_layoffs');
const projectedLayoffs=metricsById.get('forecast_layoffs_2026')??metricsById.get('projected_layoffs');
const signals=[
  revenue&&`${revenue.display_value} global revenue forecast; ${revenue.detail}.`,
  openRoles&&`${openRoles.display_value} tracked openings${entryShare&&engineeringShare?`, with ${entryShare.display_value} entry-level and ${engineeringShare.display_value} engineering`:''}.`,
  layoffs&&`${layoffs.display_value} confirmed layoffs${projectedLayoffs?`; ${projectedLayoffs.display_value} projected for the full year`:''}.`
].filter((signal):signal is string=>Boolean(signal));
---
<BaseLayout title="Game Industry Observatory">
  <section class="hero">
    <p class="eyebrow">Latest snapshot</p>
    <h1>{latest.data.title}</h1>
    <p class="lede">{latest.data.summary}</p>
    <div class="meta">
      <span>{latest.data.published.toLocaleDateString('en-GB', { day:'numeric', month:'long', year:'numeric' })}</span>
      <span>{latest.data.human_reviewed ? `Human reviewed by ${latest.data.reviewer}` : 'Not human reviewed'}</span>
    </div>
  </section>
  <SnapshotOverview report={latest} />
  <section class="panel signal-board">
    <p class="eyebrow">Signal board</p><h2>Key findings</h2><ul>{signals.map(signal=><li>{signal}</li>)}</ul>
  </section>
  <details class="full-report evidence-disclosure">
    <summary><span><strong>View evidence base</strong><small>Browse monitored, statistical and administrative sources by category</small></span><span aria-hidden="true">Open sources</span></summary>
    <div class="report evidence-report"><EvidenceBase /></div>
  </details>
  <details class="full-report">
    <summary>
      <span><strong>Read the full report</strong><small>Employment, market, company and source tables</small></span>
      <span aria-hidden="true">Open report</span>
    </summary>
    <article class="report prose"><Content /><ReportDataTables report={latest} /></article>
  </details>
  <section class="quick-links">
    <a class="card" href={`${import.meta.env.BASE_URL}history/`}><strong>Data</strong><span>Track source-level figures across reporting periods.</span></a>
    <a class="card" href={`${import.meta.env.BASE_URL}methodology/`}><strong>Methodology</strong><span>Understand scope, limitations and AI provenance.</span></a>
    <a class="card" href={`${import.meta.env.BASE_URL}sources/`}><strong>Sources & contributions</strong><span>Inspect the source registry or propose one we should track.</span></a>
  </section>
</BaseLayout>
