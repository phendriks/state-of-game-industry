---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SnapshotOverview from '../components/SnapshotOverview.astro';
import ReportDataTables from '../components/ReportDataTables.astro';
import EvidenceBase from '../components/EvidenceBase.astro';
const allReports = (await getCollection('reports'))
  .sort((a: CollectionEntry<'reports'>,b: CollectionEntry<'reports'>) => b.data.published.getTime() - a.data.published.getTime());
const reports = allReports
  .filter((report: CollectionEntry<'reports'>)=>report.data.report_type==='monthly_snapshot')
const baseline = allReports.find((report: CollectionEntry<'reports'>)=>report.data.report_type==='year_to_date_baseline');
const latest = reports[0];
const { Content } = await render(latest);
const latestObservationIds=new Set((latest.data.statistical_observations??[]).map(observation=>observation.id));
const dashboardObservations=[
  ...(latest.data.statistical_observations??[]),
  ...(baseline?.data.statistical_observations??[]).filter(observation=>!latestObservationIds.has(observation.id))
];
const dashboardTalent=(latest.data.talent_pipeline||baseline?.data.talent_pipeline) ? {
  ...(baseline?.data.talent_pipeline??{}),
  ...(latest.data.talent_pipeline??{}),
  workforce_flow:{
    ...(baseline?.data.talent_pipeline?.workforce_flow??{}),
    ...(latest.data.talent_pipeline?.workforce_flow??{})
  }
} : undefined;
const dashboardReport={
  ...latest,
  data:{
    ...latest.data,
    statistical_observations:dashboardObservations,
    talent_pipeline:dashboardTalent
  }
};
type SignalMetric={id:string;label:string;display_value:string};
const baselineMetrics=new Map<string,SignalMetric>(((baseline?.data.metrics??[]) as SignalMetric[]).map(metric=>[metric.id,metric]));
const baselineSignals=(baseline?.data.baseline_findings??[]).map(finding=>({
  title:finding.title,
  evidence:finding.observation_ids
    .map(metricId=>baselineMetrics.get(metricId))
    .filter((metric):metric is SignalMetric=>Boolean(metric))
    .map(metric=>`${metric.label}: ${metric.display_value}`)
    .join('; ')
}));
---
<BaseLayout title="Game Industry Observatory">
  <section class="hero">
    <p class="eyebrow">Latest snapshot</p>
    <h1>{latest.data.title}</h1>
    <p class="lede">{latest.data.summary}</p>
    <div class="meta">
      <span>{latest.data.published.toLocaleDateString('en-GB', { day:'numeric', month:'long', year:'numeric' })}</span>
      <span>{latest.data.human_reviewed ? `Human reviewed by ${latest.data.reviewer}` : 'Not human reviewed'}</span>
    </div>
  </section>
  <SnapshotOverview report={dashboardReport} />
  <section class="panel signal-board">
    <p class="eyebrow">Twelve-month baseline</p>
    <h2>What the broader evidence shows</h2>
    {baseline
      ? <>
          <p>{baseline.data.summary}</p>
          <ul>{baselineSignals.map(signal=><li><strong>{signal.title}</strong>{signal.evidence&&<span> — {signal.evidence}</span>}</li>)}</ul>
          <p><a href={`${import.meta.env.BASE_URL}reports/${baseline.id}/`}>Read Report Zero</a></p>
        </>
      : <p>No twelve-month baseline is available yet.</p>}
  </section>
  <details class="full-report evidence-disclosure">
    <summary><span><strong>View evidence base</strong><small>Browse monitored, statistical and administrative sources by category</small></span><span aria-hidden="true">Open sources</span></summary>
    <div class="report evidence-report"><EvidenceBase /></div>
  </details>
  <details class="full-report">
    <summary>
      <span><strong>Read the full report</strong><small>Employment, market, company and source tables</small></span>
      <span aria-hidden="true">Open report</span>
    </summary>
    <article class="report prose"><Content /><ReportDataTables report={latest} /></article>
  </details>
  <section class="quick-links">
    <a class="card" href={`${import.meta.env.BASE_URL}history/`}><strong>Data</strong><span>Track source-level figures across reporting periods.</span></a>
    <a class="card" href={`${import.meta.env.BASE_URL}methodology/`}><strong>Methodology</strong><span>Understand scope, limitations and AI provenance.</span></a>
    <a class="card" href={`${import.meta.env.BASE_URL}sources/`}><strong>Sources & contributions</strong><span>Inspect the source registry or propose one we should track.</span></a>
  </section>
</BaseLayout>
