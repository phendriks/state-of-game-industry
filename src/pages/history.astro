---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { NEWS_SOURCES } from '../data/newsSources';
import { REPORT_METRIC_CATEGORIES } from '../data/reportMetrics';
import type { ReportMetric } from '../data/reportMetrics';

const reports = (await getCollection('reports')).sort(
  (a, b) => a.data.published.getTime() - b.data.published.getTime()
);

const rows = new Map<string, { metric: ReportMetric; values: Map<string, ReportMetric> }>();

for (const report of reports) {
  for (const metric of report.data.metrics) {
    const row = rows.get(metric.id) ?? { metric, values: new Map<string, ReportMetric>() };
    row.metric = metric;
    row.values.set(report.id, metric);
    rows.set(metric.id, row);
  }
}

const categoryOrder = Object.fromEntries(
  REPORT_METRIC_CATEGORIES.map((category, index) => [category, index])
);
const sourceRecords = new Map(NEWS_SOURCES.map((source) => [source.name, source]));
const metricRows = [...rows.values()].sort((a, b) =>
  categoryOrder[a.metric.category] - categoryOrder[b.metric.category]
  || a.metric.label.localeCompare(b.metric.label)
);
---
<BaseLayout title="Data · Game Industry Observatory">
  <section class="hero compact">
    <p class="eyebrow">Longitudinal evidence</p>
    <h1>Data history</h1>
    <p class="lede">Compare source figures across reports. No combined industry score.</p>
  </section>

  <section class="data-key" aria-label="Data classifications">
    <div><strong>Reported</strong><span>Published or counted by the source.</span></div>
    <div><strong>Calculated</strong><span>Formula and inputs stored.</span></div>
    <div><strong>Forecast</strong><span>A projection.</span></div>
    <div><strong>Estimate</strong><span>A modelled figure.</span></div>
    <div><strong>Survey</strong><span>Applies to the survey population.</span></div>
  </section>

  <section class="panel data-panel">
    <div class="data-heading">
      <div><p class="eyebrow">Tracked metrics</p><h2>{metricRows.length} series</h2></div>
      <p>Columns show report dates. “Observed” is the date the figure applies to.</p>
    </div>
    <div class="data-table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Metric</th>
            <th>Type</th>
            <th>Source and context</th>
            {reports.map((report) => (
              <th><a href={`${import.meta.env.BASE_URL}reports/${report.id}/`}>{report.data.published.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</a></th>
            ))}
          </tr>
        </thead>
        <tbody>
          {metricRows.map(({ metric, values }) => (
            <tr>
              <td><span class="data-category">{metric.category}</span><strong>{metric.label}</strong></td>
              <td><span class={`data-kind data-kind--${metric.kind.toLowerCase()}`}>{metric.kind}</span></td>
              <td><strong><a href={sourceRecords.get(metric.source)?.url}>{metric.source}</a></strong><small>{metric.scope}</small><small>{metric.detail}</small>{metric.calculation && <small>Calculation: {metric.calculation}</small>}{metric.inputs && <small>Inputs: {metric.inputs.map((input) => `${input.label} ${input.display_value}`).join('; ')}</small>}{(metric.origin || metric.source_relationship) && <details class="source-context"><summary>Source relationship</summary>{metric.origin && <small>Origin: {metric.origin}</small>}{metric.source_relationship && <small>Relationship: {metric.source_relationship}</small>}</details>}</td>
              {reports.map((report) => {
                const value = values.get(report.id);
                return <td class="data-value">{value ? <><strong>{value.display_value}</strong><small>Observed {value.observed_on.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</small></> : <span>—</span>}</td>;
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="panel"><h2>Reports</h2><div class="report-list">{reports.slice().reverse().map((report) => <a href={`${import.meta.env.BASE_URL}reports/${report.id}/`}><span>{report.data.title}</span><time>{report.data.published.toLocaleDateString('en-GB')}</time></a>)}</div></section>
</BaseLayout>
