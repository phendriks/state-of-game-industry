---
import BaseLayout from '../layouts/BaseLayout.astro';
import { NEWS_SOURCE_CATEGORIES, NEWS_SOURCES } from '../data/newsSources';
---
<BaseLayout title="Sources · Game Industry Observatory">
  <section class="hero compact">
    <p class="eyebrow">Evidence base</p>
    <h1>Source registry</h1>
    <p class="lede">The {NEWS_SOURCES.length} sources below form the canonical starting set for each reporting run. Inclusion means a source is monitored—not that every claim it makes is accepted.</p>
    <a class="button" href={`${import.meta.env.BASE_URL}submit-source/`}>Propose a source</a>
  </section>

  <div class="source-list">
    {NEWS_SOURCE_CATEGORIES.map((group) => (
      <section class="source-section" aria-labelledby={`source-${group.id}`}>
        <div class="source-section-heading">
          <h2 id={`source-${group.id}`}>{group.name}</h2>
          <p>{group.description}</p>
        </div>
        <div class="source-table-wrap">
          <table class="source-table">
            <thead><tr><th>Source</th><th>What it covers</th><th>Cadence</th></tr></thead>
            <tbody>
              {group.sources.map((source) => (
                <tr>
                  <td><a href={source.url}>{source.name}</a></td>
                  <td>{source.coverage}</td>
                  <td>{source.cadence}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}
  </div>

  <section class="panel registry-note">
    <div><p class="eyebrow">How this stays transparent</p><h2>One public list, reviewed changes</h2></div>
    <p>Contributors propose edits directly to <code>src/data/newsSources.ts</code> through a pull request. The repository owner reviews every proposal before merging it. That file powers this page and is the required starting point for every new report, so the disclosed list and collection input cannot quietly drift apart.</p>
  </section>
</BaseLayout>
