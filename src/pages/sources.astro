---
import BaseLayout from '../layouts/BaseLayout.astro';
import EvidenceBase from '../components/EvidenceBase.astro';
import { NEWS_SOURCES } from '../data/newsSources';
import { STATISTICAL_SOURCES } from '../data/statisticalSources';
const sourceCount=NEWS_SOURCES.length+STATISTICAL_SOURCES.filter(source=>source.active).length;
---
<BaseLayout title="Sources · Game Industry Observatory">
  <section class="hero compact">
    <p class="eyebrow">Evidence base</p><h1>Source registry</h1>
    <p class="lede">{sourceCount} sources monitored. Each claim is checked separately.</p>
    <a class="button" href={`${import.meta.env.BASE_URL}submit-source/`}>Propose a source</a>
  </section>
  <EvidenceBase />
  <section class="panel registry-note"><div><p class="eyebrow">Contributions</p><h2>Reviewed source changes</h2></div><p>Suggest changes by pull request. The owner reviews them before merging. Source labels describe context, not quality.</p></section>
</BaseLayout>
