---
import BaseLayout from '../layouts/BaseLayout.astro';
import EvidenceBase from '../components/EvidenceBase.astro';
import { NEWS_SOURCES } from '../data/newsSources';
import { STATISTICAL_SOURCES } from '../data/statisticalSources';
const sourceCount=NEWS_SOURCES.length+STATISTICAL_SOURCES.filter(source=>source.active).length;
---
<BaseLayout title="Sources · Game Industry Observatory">
  <section class="hero compact">
    <p class="eyebrow">Evidence base</p><h1>Source registry</h1>
    <p class="lede">These {sourceCount} monitored and statistical sources form the canonical evidence base. Inclusion means a source is available to the workflow—not that every claim it makes is accepted.</p>
    <a class="button" href={`${import.meta.env.BASE_URL}submit-source/`}>Propose a source</a>
  </section>
  <EvidenceBase />
  <section class="panel registry-note"><div><p class="eyebrow">How this stays transparent</p><h2>One public list, reviewed changes</h2></div><p>Contributors propose edits to the canonical registries through a pull request. The repository owner reviews every proposal before merging it. Source type, language and affiliation provide context only. They are not quality scores.</p></section>
</BaseLayout>
