---
import type { DashboardMetricCard } from '../data/dashboardMetrics';
interface Props { metric: DashboardMetricCard }
const { metric } = Astro.props;
const provenance = metric.status === 'available' ? metric.kind : 'Unavailable';
---
<article class:list={['metric',{'metric--missing':metric.status!=='available'}]}>
  <p>{metric.label}</p>
  <strong>{metric.value}</strong>
  {metric.secondaryValue&&<span>{metric.secondaryValue}</span>}
  <small>{provenance} · {metric.sourceUrl?<a href={metric.sourceUrl}>{metric.source}</a>:metric.source}</small>
</article>
