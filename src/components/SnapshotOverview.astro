---
type Tone = 'positive' | 'negative' | 'mixed' | 'neutral';
type Metric = { label: string; value: string; detail: string; tone: Tone };
type Signal = { label: string; reading: string; evidence: string; confidence: string; tone: Tone };

interface Props { report: { data: { key_metrics: Metric[]; signals: Signal[]; thesis: string } } }

const { report } = Astro.props;
const { signals = [], key_metrics: keyMetrics = [], thesis } = report.data;
---
<section class="snapshot" aria-labelledby="snapshot-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow">At a glance</p>
      <h2 id="snapshot-title">The state of the industry</h2>
    </div>
    <p>{thesis}</p>
  </div>

  <div class="metric-grid">
    {keyMetrics.map((metric) => (
      <article class={`metric metric--${metric.tone}`}>
        <p>{metric.label}</p>
        <strong>{metric.value}</strong>
        <span>{metric.detail}</span>
      </article>
    ))}
  </div>

  <div class="signal-board" role="table" aria-label="Current industry signals">
    <div class="signal-row signal-row--head" role="row">
      <span role="columnheader">Signal</span>
      <span role="columnheader">Reading</span>
      <span role="columnheader">Evidence</span>
      <span role="columnheader">Confidence</span>
    </div>
    {signals.map((signal) => (
      <div class="signal-row" role="row">
        <strong role="cell">{signal.label}</strong>
        <span role="cell"><span class={`status status--${signal.tone}`}>{signal.reading}</span></span>
        <span class="signal-evidence" role="cell">{signal.evidence}</span>
        <span class="confidence" role="cell">{signal.confidence}</span>
      </div>
    ))}
  </div>
</section>
