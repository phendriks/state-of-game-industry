---
type Metric = { label: string; display_value: string; detail: string; featured: boolean };

interface Props { report: { data: { metrics: Metric[] } } }

const { report } = Astro.props;
const { metrics = [] } = report.data;
const featuredMetrics = metrics.filter((metric) => metric.featured);
---
<section class="snapshot" aria-labelledby="snapshot-title">
  <div class="section-heading">
    <p class="eyebrow">At a glance</p>
    <h2 id="snapshot-title">The state of the industry</h2>
  </div>

  <div class="metric-grid">
    {featuredMetrics.map((metric) => (
      <article class="metric">
        <p>{metric.label}</p>
        <strong>{metric.display_value}</strong>
        <span>{metric.detail}</span>
      </article>
    ))}
  </div>

</section>
