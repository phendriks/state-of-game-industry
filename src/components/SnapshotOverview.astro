---
import MetricCard from './MetricCard.astro';
import { buildDashboardSections } from '../data/dashboardMetrics';
interface Props { report: { data: Parameters<typeof buildDashboardSections>[0] } }
const { report } = Astro.props;
const sections = buildDashboardSections(report.data);
---
<section class="snapshot" aria-labelledby="snapshot-title">
  <div class="section-heading"><p class="eyebrow">At a glance</p><h2 id="snapshot-title">The state of the industry</h2></div>
  {sections.map((section)=>(
    <section class="metric-section" aria-labelledby={`metrics-${section.id}`}>
      <div class="metric-section-heading"><h3 id={`metrics-${section.id}`}>{section.title}</h3><p>{section.description}</p></div>
      <div class="metric-grid">{section.metrics.map((metric)=><MetricCard metric={metric}/>)}</div>
    </section>
  ))}
</section>
