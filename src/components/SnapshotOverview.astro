---
import { SNAPSHOT_INDICATORS } from '../data/snapshotIndicators';

type Metric = { id: string; label: string; display_value: string; detail: string; kind: string; source: string; observed_on: Date; carried_forward?: boolean; featured?: boolean };

interface Props { report: { data: { snapshot?: Record<string, string>; metrics: Metric[] } } }

const { report } = Astro.props;
const { snapshot, metrics = [] } = report.data;
const metricsById = new Map(metrics.map((metric) => [metric.id, metric]));
const snapshotMetrics = snapshot
  ? SNAPSHOT_INDICATORS.map((indicator) => {
      const metric = metricsById.get(snapshot[indicator.key]);
      return metric ? { ...metric, dashboardLabel: indicator.label } : undefined;
    }).filter((metric): metric is NonNullable<typeof metric> => metric !== undefined)
  : [];
const featuredMetrics = snapshot
  ? snapshotMetrics
  : metrics.filter((metric) => metric.featured).map((metric) => ({ ...metric, dashboardLabel: metric.label }));
---
<section class="snapshot" aria-labelledby="snapshot-title">
  <div class="section-heading">
    <p class="eyebrow">At a glance</p>
    <h2 id="snapshot-title">The state of the industry</h2>
  </div>

  <div class="metric-grid">
    {featuredMetrics.map((metric) => (
      <article class="metric">
        <p>{metric.dashboardLabel}</p>
        <strong>{metric.display_value}</strong>
        <span>{metric.detail}</span>
        <small>{metric.kind} &middot; {metric.source}{metric.carried_forward ? ` · carried forward; observed ${metric.observed_on.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}` : ''}</small>
      </article>
    ))}
  </div>

</section>
